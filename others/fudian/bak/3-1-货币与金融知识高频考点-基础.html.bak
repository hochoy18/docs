<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>货币与金融知识高频考点总结（基础）</title>
<style>
:root{
  --bg:#f5f6f8; --panel:#ffffff; --ink:#1d2129; --ink-2:#4a5158; --ink-3:#828a94;
  --line:#e3e6ea; --line-2:#eef0f3; --accent:#b3261e; --accent-2:#1a56a8;
  --red:#c62828; --red-bg:#fff5f5; --sidebar:300px;
  --font-serif:"Songti SC","STSong","SimSun","Source Han Serif SC",serif;
  --font-sans:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Helvetica Neue",Arial,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:var(--font-serif);font-size:16.5px;line-height:1.95;-webkit-font-smoothing:antialiased;}

/* ---------- sidebar ---------- */
#sidebar{position:fixed;inset:0 auto 0 0;width:var(--sidebar);background:var(--panel);
  border-right:1px solid var(--line);display:flex;flex-direction:column;z-index:40}
.sb-head{padding:18px 20px 12px;border-bottom:1px solid var(--line-2)}
.sb-title{font-family:var(--font-sans);font-size:15px;font-weight:700;line-height:1.5;color:var(--ink)}
.sb-sub{font-family:var(--font-sans);font-size:11.5px;color:var(--ink-3);margin-top:5px;letter-spacing:.3px}
.sb-search{padding:12px 16px 10px}
.sb-search input{width:100%;padding:7px 10px;border:1px solid var(--line);border-radius:6px;
  font-family:var(--font-sans);font-size:12.5px;background:#fbfcfd;color:var(--ink);outline:none}
.sb-search input:focus{border-color:#b9c6d6;background:#fff}
#toc{flex:1;overflow-y:auto;padding:6px 10px 60px;scrollbar-width:thin}
#toc a{display:block;font-family:var(--font-sans);text-decoration:none;color:var(--ink-2);
  border-radius:5px;padding:5px 10px;line-height:1.5;border-left:2px solid transparent;transition:.14s}
#toc a:hover{background:#f2f4f7;color:var(--ink)}
.toc-l1{font-size:13.5px;font-weight:700;color:var(--ink);margin-top:12px;padding-top:7px!important}
.toc-l2{font-size:12.5px;color:#384049;margin-left:10px}
.toc-l3{font-size:12px;color:var(--ink-3);margin-left:22px;padding-top:3px!important;padding-bottom:3px!important}
#toc a.active{background:#eaf1fb;color:var(--accent-2);border-left-color:var(--accent-2);font-weight:600}
.toc-l1.active{color:var(--accent-2)}
.sb-foot{padding:10px 16px;border-top:1px solid var(--line-2);font-family:var(--font-sans);
  font-size:11px;color:var(--ink-3);display:flex;justify-content:space-between;align-items:center}
.sb-foot button{font-family:var(--font-sans);font-size:11px;border:1px solid var(--line);
  background:#fff;border-radius:5px;padding:3px 8px;cursor:pointer;color:var(--ink-2)}
.sb-foot button:hover{background:#f2f4f7}

/* ---------- main ---------- */
#main{margin-left:var(--sidebar);min-height:100vh}
#progress{position:fixed;top:0;left:var(--sidebar);right:0;height:2px;background:transparent;z-index:45}
#progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,#2f6fd0,#b3261e)}
#content{max-width:900px;margin:0 auto;padding:34px 46px 120px}

/* cover */
.cover{background:var(--panel);border:1px solid var(--line);border-radius:12px;
  padding:46px 48px 38px;margin-bottom:26px}
.cover h1{font-family:var(--font-sans);font-size:31px;font-weight:800;margin:0 0 10px;letter-spacing:.5px}
.cover .cv-sub{font-family:var(--font-sans);font-size:14px;color:var(--ink-3);margin-bottom:22px}
.cv-meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.cv-meta span{font-family:var(--font-sans);font-size:12px;background:#f2f4f7;color:var(--ink-2);
  border:1px solid var(--line);border-radius:20px;padding:3px 11px}
.cv-note{font-family:var(--font-sans);font-size:12.5px;line-height:1.85;color:var(--ink-3);
  border-top:1px dashed var(--line);padding-top:16px}
.cv-note b{color:var(--ink-2)}

/* headings */
h1,h2,h3,h4,h5,h6{font-family:var(--font-sans);scroll-margin-top:14px}
.c-h1{font-size:25px;font-weight:800;margin:52px 0 20px;padding:14px 18px;color:#fff;
  background:linear-gradient(100deg,#1f3f6d,#2f6fd0);border-radius:8px;letter-spacing:.5px}
.c-h2{font-size:20px;font-weight:700;margin:40px 0 16px;padding:9px 0 9px 14px;
  border-left:5px solid var(--accent-2);color:#123;line-height:1.5}
.c-h3{font-size:17px;font-weight:700;margin:32px 0 13px;padding:7px 12px;background:#eef3fb;
  color:#173f75;border-radius:6px;border:1px solid #dde7f6}
.c-h4{font-size:16px;font-weight:700;margin:24px 0 10px;color:#1d2129}
.c-h5{font-size:15.5px;font-weight:600;margin:18px 0 8px;color:#2b3138}
.c-h6{font-size:15px;font-weight:600;margin:14px 0 6px;color:var(--ink-2)}

p{margin:0 0 12px;text-align:justify}
p.li{margin:0 0 7px;padding-left:1.5em;text-indent:-1.5em}
.r{color:var(--red);font-weight:600}
u{text-decoration-color:#c96;font-weight:600;text-underline-offset:3px}

/* callout */
.callout{background:var(--red-bg);border:1px solid #f3d3d3;border-left:4px solid var(--red);
  border-radius:6px;padding:11px 16px;margin:14px 0}
.callout .co-tag{font-family:var(--font-sans);font-weight:700;color:var(--red);margin-bottom:2px}
.callout p{margin:4px 0}
p.co-lead{margin:13px 0 7px}

/* tables */
.tw{overflow-x:auto;margin:16px 0 22px;border:1px solid var(--line);border-radius:8px;background:#fff}
table{border-collapse:collapse;width:100%;font-size:15px;table-layout:fixed}
td{border:1px solid var(--line);padding:9px 12px;vertical-align:top;line-height:1.85}
tr:first-child td{background:#f7f9fc}
td p{margin:0 0 6px}
td p:last-child{margin-bottom:0}
td:empty{background:#fafbfc}

/* figures */
figure.fig{margin:20px 0 24px;padding:14px 16px 10px;border:1px solid var(--line);
  border-radius:10px;background:#fff;text-align:center}
figure.fig img{max-width:100%;height:auto;display:block;margin:0 auto;
  image-rendering:-webkit-optimize-contrast}
figure.fig figcaption{font-family:var(--font-sans);font-size:13px;color:var(--ink-2);
  margin-top:10px;letter-spacing:.3px}
figure.fig .figtext{text-align:left;border-top:1px dashed var(--line);margin-top:10px;
  padding-top:8px}
figure.fig .figtext p{margin:4px 0;font-size:14.5px;color:var(--ink-2)}
figure.fig .figtext h1,figure.fig .figtext h2,figure.fig .figtext h3,
figure.fig .figtext h4,figure.fig .figtext h5,figure.fig .figtext h6{
  font-size:15px;margin:6px 0 2px}

/* page marker */
.pagebreak{position:relative;height:0;margin:0}
.pg-mark{position:absolute;right:4px;top:-14px;font-family:var(--font-sans);font-size:10.5px;
  color:#b9c0c8;background:var(--bg);padding:0 6px;letter-spacing:.5px}
/* tools */
#totop{position:fixed;right:26px;bottom:26px;width:42px;height:42px;border-radius:50%;
  border:1px solid var(--line);background:#fff;box-shadow:0 3px 14px rgba(20,30,50,.12);
  cursor:pointer;font-size:17px;color:var(--ink-2);display:none;z-index:50}
#totop:hover{color:var(--accent-2);border-color:#b9c6d6}
#menubtn{display:none;position:fixed;left:14px;top:12px;z-index:60;width:38px;height:34px;
  border:1px solid var(--line);background:#fff;border-radius:6px;font-size:16px;cursor:pointer;
  box-shadow:0 2px 8px rgba(20,30,50,.1)}
#mask{display:none;position:fixed;inset:0;background:rgba(20,28,40,.35);z-index:35}

@media (max-width:900px){
  :root{--sidebar:280px}
  #menubtn{display:block}
  #sidebar{transform:translateX(-100%);transition:transform .22s ease}
  #sidebar.open{transform:none}
  #main{margin-left:0}
  #content{padding:22px 18px 90px}
  .cover{padding:30px 24px 26px}
  .cover h1{font-size:24px}
  #progress{left:0}
  #toc a.toc-l3{font-size:11.5px}
}
@media print{
  #sidebar,#totop,#menubtn,#mask,#progress{display:none!important}
  #main{margin:0}
  #content{max-width:none;padding:0}
  body{background:#fff;font-size:11pt}
  .cover,.tw{break-inside:avoid}
  .c-h1{background:#1f3f6d!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .r,.callout .co-tag{color:var(--red)!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
